{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/server/index.ts",
    "src/client/main.tsx"
  ],
  "project": [
    "src/**/*.{ts,tsx}"
  ],
  "ignore": [
    "dist/**",
    "coverage/**"
  ],
  "ignoreDependencies": [
    "@semantic-release/*",
    "semantic-release",
    "@commitlint/*",
    "commitizen",
    "cz-conventional-changelog",
    "conventional-changelog-conventionalcommits",
    "husky",
    "@vitest/coverage-v8"
  ]
}
