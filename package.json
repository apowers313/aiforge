{
  "name": "aiforge",
  "version": "0.0.0",
  "description": "A web-based IDE for 100% agentic coding - manage AI agents through terminals, not files",
  "main": "dist/server/server/index.js",
  "types": "dist/server/server/index.d.ts",
  "type": "module",
  "bin": {
    "aiforge": "bin/aiforge.js"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./dist/server/server/index.js",
      "types": "./dist/server/server/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json && tsc-alias -p tsconfig.server.json",
    "build:client": "vite build",
    "dev": "npm run dev:server && sleep 10 && npm run dev:client",
    "dev:server": "npx servherd start -n aiforge-server-dev -e AIFORGE_PORT={{port}} --port 9050 -e AIFORGE_AUTH_GUID={{aiforge-auth}} -- tsx watch src/server/index.ts",
    "dev:client": "npx servherd start -n aiforge-client-dev -e HOST={{hostname}} -e AIFORGE_AUTH_GUID={{aiforge-auth}} 'AIFORGE_SERVER_PORT={{$ \"aiforge-server-dev\" \"port\"}}' -- vite --port {{port}} --host {{hostname}}",
    "dev:ci": "concurrently --kill-others \"CI=true tsx src/server/index.ts\" \"vite --port ${VITE_PORT:-9050}\"",
    "e2e:backend": "servherd start -n e2e-backend -e 'E2E_TEST=true' -e 'AIFORGE_PORT={{port}}' -e 'AIFORGE_AUTH_GUID=e2e-test-guid' -e 'AIFORGE_DATA_DIR=./tmp/e2e-data' -- tsx src/server/index.ts",
    "e2e:frontend": "servherd start -n e2e-frontend -e 'AIFORGE_SERVER_PORT={{$ \"e2e-backend\" \"port\"}}' -- vite --port {{port}} --host",
    "e2e:backend:restart": "servherd restart e2e-backend",
    "e2e:frontend:restart": "servherd restart e2e-frontend",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "commit": "cz",
    "build:all": "npm run build && npm run build:client",
    "prod": "npm run build:all && servherd start -n aiforge-prod -e AIFORGE_AUTH_GUID={{aiforge-auth}} -- node bin/aiforge.js --port {{port}} --host {{hostname}} --https-cert {{httpsCert}} --https-key {{httpsKey}}",
    "prepublishOnly": "npm run lint && npm run build:all && npm run test",
    "knip": "knip",
    "generate-guid": "tsx scripts/generate-guid.ts"
  },
  "keywords": [
    "ai",
    "ide",
    "terminal",
    "agentic",
    "coding",
    "pty",
    "cli",
    "web-terminal",
    "agent",
    "llm"
  ],
  "author": "apowers313",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apowers313/aiforge.git"
  },
  "bugs": {
    "url": "https://github.com/apowers313/aiforge/issues"
  },
  "homepage": "https://github.com/apowers313/aiforge#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@graphty/compact-mantine": "^0.5.0",
    "@graphty/remote-logger": "^1.2.3",
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1",
    "@mantine/core": "^8.0.1",
    "@mantine/hooks": "^8.0.1",
    "@monaco-editor/react": "^4.7.0",
    "@tabler/icons-react": "^3.28.1",
    "@tanstack/react-query": "^5.90.16",
    "@tanstack/react-query-devtools": "^5.91.2",
    "@types/ws": "^8.18.1",
    "@uiw/react-md-editor": "^4.0.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "commander": "^14.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "fs-extra": "^11.3.3",
    "lucide-react": "^0.562.0",
    "pino": "^9.6.0",
    "proper-lockfile": "^4.1.2",
    "pupt": "^1.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-photo-view": "^1.2.7",
    "react-resizable-panels": "^4.4.1",
    "react-router-dom": "^7.1.3",
    "simple-git": "^3.30.0",
    "use-sync-external-store": "^1.6.0",
    "uuid": "^13.0.0",
    "ws": "^8.19.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.50.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.3",
    "@semantic-release/npm": "^13.1.0",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@stylistic/eslint-plugin": "^2.13.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.10",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.4",
    "commitizen": "^4.3.1",
    "concurrently": "^9.1.2",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "knip": "^5.44.0",
    "semantic-release": "^25.0.0",
    "servherd": "^1.1.0",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vite": "^6.0.11",
    "vitest": "^3.0.4"
  }
}
